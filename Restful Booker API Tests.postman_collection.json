  "item": [
    {
      "name": "Login (get token)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const body = pm.response.json();\r\n\r\npm.test(\"Login returns a token\", function () {\r\n    pm.response.to.have.status(200);\r\n    pm.expect(body.token).to.be.a(\"string\").and.not.empty;\r\n});\r\n\r\npm.collectionVariables.set(\"token\", body.token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n    \"username\": \"admin\",\r\n    \"password\": \"password123\"\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "https://restful-booker.herokuapp.com/auth",
          "protocol": "https",
          "host": [
            "restful-booker",
            "herokuapp",
            "com"
          ],
          "path": [
            "auth"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Create booking",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const body = pm.response.json();\r\n\r\npm.test(\"Status code is 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"Response returns a booking ID\", function () {\r\n    pm.expect(body.bookingid).to.be.a(\"number\");\r\n});\r\n\r\npm.test(\"Saved data matches what was sent\", function () {\r\n    const sent = JSON.parse(pm.request.body.raw);\r\n    pm.expect(body.booking.firstname).to.eql(sent.firstname);\r\n    pm.expect(body.booking.totalprice).to.eql(sent.totalprice);\r\n});\r\n\r\npm.collectionVariables.set(\"bookingId\", body.bookingid);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n    \"firstname\": \"Testing\",\r\n    \"lastname\": \"Tester\",\r\n    \"totalprice\": 150,\r\n    \"depositpaid\": true,\r\n    \"bookingdates\": {\r\n        \"checkin\": \"2026-12-01\",\r\n        \"checkout\": \"2026-12-05\"\r\n    },\r\n    \"additionalneeds\": \"Breakfast\"\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "https://restful-booker.herokuapp.com/booking",
          "protocol": "https",
          "host": [
            "restful-booker",
            "herokuapp",
            "com"
          ],
          "path": [
            "booking"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Get booking by ID",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"Booking has correct fields and types\", function () {\r\n    const body = pm.response.json();\r\n\r\n    pm.expect(body.firstname).to.be.a(\"string\");\r\n    pm.expect(body.totalprice).to.be.a(\"number\");\r\n    pm.expect(body.depositpaid).to.be.a(\"boolean\");\r\n    pm.expect(body.bookingdates).to.have.property(\"checkin\");\r\n});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "https://restful-booker.herokuapp.com/booking/{{bookingId}}",
          "protocol": "https",
          "host": [
            "restful-booker",
            "herokuapp",
            "com"
          ],
          "path": [
            "booking",
            "{{bookingId}}"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Update booking",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const body = pm.response.json();\r\nconst sent = JSON.parse(pm.request.body.raw);\r\n\r\npm.test(\"Status code is 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"Booking was updated with the new data\", function () {\r\n    pm.expect(body).to.eql(sent);\r\n});"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Cookie",
            "value": "token={{token}}"
          }
        ],
        "body": {
